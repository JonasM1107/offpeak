# Copy this file to .env and fill in the values. Never commit .env.
# Supabase: use the "Session pooler" connection string (GitHub Actions cannot reach the direct one).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Optional, only for European price zones outside Germany and Portugal.
ENTSOE_TOKEN=
# Ollie, the chat assistant: a Claude key from the Claude Console. Without it Ollie says it is unavailable.
ANTHROPIC_API_KEY=
# Optional: another Claude model for Ollie than the default in offpeak/assistant/claude.py.
OLLIE_MODEL=
# Editors who may change shared data (site components, cockpit machines) after signing in.
# Comma-separated emails, each optionally as "Name <email>". Each account gets one role
# (Homeowner or Business) at its first sign-in, so a demo of both portals needs two emails.
# The password is stored only as a fingerprint, made with:
#   uv run python -c "from offpeak.auth import hash_password; print(hash_password('...'))"
# and a long random secret that signs the 24-hour login cookie:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
OFFPEAK_EDITORS=
OFFPEAK_PASSWORD_HASH=
OFFPEAK_AUTH_SECRET=
