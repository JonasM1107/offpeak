# Copy this file to .env and fill in the values. Never commit .env.
# Supabase: use the "Session pooler" connection string (GitHub Actions cannot reach the direct one).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Optional, only for European price zones outside Germany and Portugal.
ENTSOE_TOKEN=
